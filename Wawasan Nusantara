function createClouds() {
    for (let i = 0; i < 15; i++) {
        const cloudGroup = new THREE.Group();
        const cloudMat = new THREE.MeshStandardMaterial({ 
            color: 0xffffff, 
            transparent: true, 
            opacity: 0.6,
            roughness: 1
        });
        
        for (let j = 0; j < 4; j++) {
            const sphereGeo = new THREE.SphereGeometry(2 + Math.random() * 2, 8, 8);
            const sphere = new THREE.Mesh(sphereGeo, cloudMat);
            sphere.position.set(
                (Math.random() - 0.5) * 6,
                (Math.random() - 0.5) * 2,
                (Math.random() - 0.5) * 4
            );
            sphere.castShadow = true;
            cloudGroup.add(sphere);
        }
        
        cloudGroup.position.set(
            (Math.random() - 0.5) * worldSize,
            30 + Math.random() * 20,
            (Math.random() - 0.5) * worldSize
        );
        cloudGroup.userData.speed = 0.05 + Math.random() * 0.1;
        scene.add(cloudGroup);
        clouds.push(cloudGroup);
    }
}

// ==================== PLAYER MOVEMENT ====================
let joystickInput = { x: 0, y: 0 };
let joystickActive = false;
let joystickCenter = { x: 0, y: 0 };

function setupJoystick() {
    const area = document.getElementById('joystick-area');
    const knob = document.getElementById('joystick-knob');
    const base = area.querySelector('.joystick-base');
    const maxDist = 40;

    function getCenter() {
        const rect = base.getBoundingClientRect();
        return { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
    }

    function handleStart(e) {
        e.preventDefault();
        joystickActive = true;
        joystickCenter = getCenter();
        handleMove(e);
    }

    function handleMove(e) {
        if (!joystickActive) return;
        e.preventDefault();
        
        const touch = e.touches ? e.touches[0] : e;
        const dx = touch.clientX - joystickCenter.x;
        const dy = touch.clientY - joystickCenter.y;
        
        const dist = Math.sqrt(dx * dx + dy * dy);
        const clampedDist = Math.min(dist, maxDist);
        const angle = Math.atan2(dy, dx);
        
        const knobX = Math.cos(angle) * clampedDist;
        const knobY = Math.sin(angle) * clampedDist;
        
        knob.style.transform = `translate(calc(-50% + ${knobX}px), calc(-50% + ${knobY}px))`;
        
        joystickInput.x = knobX / maxDist;
        joystickInput.y = knobY / maxDist;
    }

    function handleEnd(e) {
        e.preventDefault();
        joystickActive = false;
        joystickInput.x = 0;
        joystickInput.y = 0;
        knob.style.transform = 'translate(-50%, -50%)';
    }

    area.addEventListener('touchstart', handleStart, { passive: false });
    area.addEventListener('touchmove', handleMove, { passive: false });
    area.addEventListener('touchend', handleEnd, { passive: false });
    area.addEventListener('touchcancel', handleEnd, { passive: false });

    area.addEventListener('mousedown', handleStart);
    window.addEventListener('mousemove', handleMove);
    window.addEventListener('mouseup', handleEnd);
}

// ==================== GAME LOGIC ====================
function getNearestIsland() {
    let nearest = null;
    let minDist = Infinity;
    
    islands.forEach(island => {
        const dx = island.position.x - player.position.x;
        const dz = island.position.z - player.position.z;
        const dist = Math.sqrt(dx * dx + dz * dz);
        
        if (dist < minDist) {
            minDist = dist;
            nearest = { island, dist };
        }
    });
    
    return nearest;
}

function checkIslandProximity() {
    const nearest = getNearestIsland();
    const islandNameEl = document.getElementById('island-name');
    const islandDescEl = document.getElementById('island-desc');
    
    if (nearest && nearest.dist < 15) {
        const data = nearest.island.userData.data;
        islandNameEl.textContent = data.name;
        islandDescEl.textContent = data.desc;
        gameState.currentIsland = nearest.island.userData.key;
        
        // Mark as visited
        if (!gameState.visitedIslands.includes(nearest.island.userData.key)) {
            // Will be marked when interaction happens
        }
    } else {
        islandNameEl.textContent = "Laut Lepas";
        islandDescEl.textContent = "Jelajahi nusantara";
        gameState.currentIsland = null;
    }
}

function showToast(message, duration = 2000) {
    const toast = document.getElementById('toast');
    toast.textContent = message;
    toast.classList.add('show');
    setTimeout(() => toast.classList.remove('show'), duration);
}

function updateUI() {
    document.getElementById('score').textContent = gameState.score;
    document.getElementById('missions').textContent = gameState.visitedIslands.length;
}

function handleInteract() {
    const nearest = getNearestIsland();
    if (!nearest || nearest.dist >= 15) {
        showToast("Dekati pulau untuk menjelajah! 🏝️");
        return;
    }

    const key = nearest.island.userData.key;
    const data = nearest.island.userData.data;
    
    if (!gameState.visitedIslands.includes(key)) {
        gameState.visitedIslands.push(key);
        gameState.score += 10;
        updateUI();
        saveGame();
        showToast("✨ Pulau baru ditemukan! +10 poin");
    }

    // Show info modal
    document.getElementById('info-title').textContent = `📖 ${data.name}`;
    document.getElementById('info-text').textContent = data.info;
    document.getElementById('modal-info').classList.add('active');
}

function handleQuiz() {
    const nearest = getNearestIsland();
    if (!nearest || nearest.dist >= 15) {
        showToast("Dekati pulau untuk mengerjakan kuis! 📝");
        return;
    }

    const key = nearest.island.userData.key;
    const data = nearest.island.userData.data;
    
    if (gameState.completedQuizzes.includes(key)) {
        showToast("Kuis pulau ini sudah diselesaikan! ✅");
        return;
    }

    // Show quiz modal
    document.getElementById('quiz-title').textContent = `📝 Kuis: ${data.name}`;
    document.getElementById('quiz-question').textContent = data.quiz.question;
    
    const optionsContainer = document.getElementById('quiz-options');
    optionsContainer.innerHTML = '';
    
    data.quiz.options.forEach((option, index) => {
        const btn = document.createElement('button');
        btn.className = 'option-btn';
        btn.textContent = option;
        btn.onclick = () => selectQuizAnswer(index, data.quiz, key, optionsContainer);
        optionsContainer.appendChild(btn);
    });

    document.getElementById('quiz-feedback').style.display = 'none';
    document.getElementById('modal-quiz').classList.add('active');
}

function selectQuizAnswer(selectedIndex, quiz, islandKey, container) {
    const buttons = container.querySelectorAll('.option-btn');
    const feedback = document.getElementById('quiz-feedback');
    
    buttons.forEach((btn, i) => {
        btn.disabled = true;
        if (i === quiz.answer) {
            btn.classList.add('correct');
        }
        if (i === selectedIndex && selectedIndex !== quiz.answer) {
            btn.classList.add('wrong');
        }
    });

    const isCorrect = selectedIndex === quiz.answer;
    
    if (isCorrect) {
        feedback.className = 'feedback correct';
        feedback.textContent = `✅ Benar! ${quiz.explanation} (+20 poin)`;
        gameState.score += 20;
        gameState.completedQuizzes.push(islandKey);
        gameState.missionsCompleted++;
        updateUI();
        saveGame();
        
        // Change marker color
        const island = islands.find(i => i.userData.key === islandKey);
        if (island) {
            island.userData.marker.material.color.setHex(0x00ff88);
            island.userData.marker.material.emissive.setHex(0x00ff88);
        }
        
        if (gameState.completedQuizzes.length >= 7) {
            setTimeout(() => {
                document.getElementById('modal-quiz').classList.remove('active');
                document.getElementById('final-score').textContent = `Skor: ${gameState.score}`;
                document.getElementById('modal-complete').classList.add('active');
            }, 2000);
        }
    } else {
        feedback.className = 'feedback wrong';
        feedback.textContent = `❌ Kurang tepat. ${quiz.explanation}`;
    }
    
    feedback.style.display = 'block';
}

// ==================== MINI MAP ====================
function updateMinimap() {
    const canvas = document.getElementById('minimap-canvas');
    const ctx = canvas.getContext('2d');
    const w = canvas.width;
    const h = canvas.height;
    const scale = w / 300;
    
    ctx.clearRect(0, 0, w, h);
    
    // Background
    ctx.fillStyle = 'rgba(0, 20, 40, 0.9)';
    ctx.fillRect(0, 0, w, h);
    
    // Draw islands
    islands.forEach(island => {
        const ix = (island.position.x + 150) * scale;
        const iy = (island.position.z + 150) * scale;
        
        ctx.beginPath();
        ctx.arc(ix, iy, 6, 0, Math.PI * 2);
        
        if (gameState.completedQuizzes.includes(island.userData.key)) {
            ctx.fillStyle = '#00ff88';
        } else if (gameState.visitedIslands.includes(island.userData.key)) {
            ctx.fillStyle = '#ffd700';
        } else {
            ctx.fillStyle = '#4488aa';
        }
        ctx.fill();
        ctx.strokeStyle = '#ffffff';
        ctx.lineWidth = 1;
        ctx.stroke();
    });
    
    // Draw player
    const px = (player.position.x + 150) * scale;
    const py = (player.position.z + 150) * scale;
    ctx.beginPath();
    ctx.arc(px, py, 4, 0, Math.PI * 2);
    ctx.fillStyle = '#ff4444';
    ctx.fill();
    ctx.strokeStyle = '#ffffff';
    ctx.lineWidth = 2;
    ctx.stroke();
    
    // Border
    ctx.strokeStyle = '#00e5ff';
    ctx.lineWidth = 2;
    ctx.strokeRect(1, 1, w-2, h-2);
}

// ==================== ANIMATION LOOP ====================
function animate() {
    requestAnimationFrame(animate);
    
    const delta = clock.getDelta();
    const time = clock.getElapsedTime();
    
    // Ocean animation
    if (waterMesh) {
        const positions = waterMesh.geometry.attributes.position;
        for (let i = 0; i < positions.count; i++) {
            const x = positions.getX(i);
            const z = positions.getZ(i);
            const y = Math.sin(x * 0.1 + time) * 0.3 + Math.cos(z * 0.1 + time * 0.8) * 0.3;
            positions.setY(i, y);
        }
        positions.needsUpdate = true;
        waterMesh.geometry.computeVertexNormals();
    }
    
    // Cloud animation
    clouds.forEach(cloud => {
        cloud.position.x += cloud.userData.speed * delta * 10;
        if (cloud.position.x > worldSize) {
            cloud.position.x = -worldSize;
        }
    });
    
    // Stars rotation
    if (stars) {
        stars.rotation.y += delta * 0.005;
    }
    
    // Player movement
    if (joystickActive || (joystickInput.x !== 0 || joystickInput.y !== 0)) {
        const speed = 15;
        const moveX = joystickInput.x * speed * delta;
        const moveZ = joystickInput.y * speed * delta;
        
        player.position.x += moveX;
        player.position.z += moveZ;
        
        // Clamp to world
        player.position.x = Math.max(-140, Math.min(140, player.position.x));
        player.position.z = Math.max(-140, Math.min(140, player.position.z));
        
        // Rotate player
        if (Math.abs(moveX) > 0.01 || Math.abs(moveZ) > 0.01) {
            const targetAngle = Math.atan2(moveX, moveZ);
            player.rotation.y = targetAngle;
        }
        
        // Bobbing animation
        player.position.y = Math.abs(Math.sin(time * 8)) * 0.15;
        gameState.isMoving = true;
    } else {
        gameState.isMoving = false;
        player.position.y = 0;
    }
    
    // Camera follow player
    const camTargetX = player.position.x;
    const camTargetZ = player.position.z + 20;
    const camTargetY = 18;
    
    camera.position.x += (camTargetX - camera.position.x) * 0.05;
    camera.position.z += (camTargetZ - camera.position.z) * 0.05;
    camera.position.y += (camTargetY - camera.position.y) * 0.05;
    camera.lookAt(player.position.x, 3, player.position.z);
    
    // Island animations
    islands.forEach(island => {
        // Marker float
        const marker = island.userData.marker;
        if (marker) {
            marker.position.y = 12 + Math.sin(time * 2 + island.position.x) * 1.5;
            marker.rotation.y += delta * 2;
        }
        
        // Ring pulse
        const ring = island.userData.ring;
        if (ring) {
            ring.scale.setScalar(1 + Math.sin(time * 1.5 + island.position.z) * 0.08);
            ring.material.opacity = 0.2 + Math.sin(time * 2 + island.position.x) * 0.15;
        }
    });
    
    // Check island proximity
    checkIslandProximity();
    
    // Update minimap
    updateMinimap();
    
    renderer.render(scene, camera);
}

function onResize() {
    camera.aspect = window.innerWidth / window.innerHeight;
    camera.updateProjectionMatrix();
    renderer.setSize(window.innerWidth, window.innerHeight);
}

// ==================== INITIALIZATION ====================
function init() {
    // Load saved game
    const loaded = loadGame();
    
    // Setup Three.js
    initThreeJS();
    
    // Setup joystick
    setupJoystick();
    
    // Setup buttons
    document.getElementById('btn-interact').addEventListener('click', handleInteract);
    document.getElementById('btn-quiz').addEventListener('click', handleQuiz);
    document.getElementById('btn-close-info').addEventListener('click', () => {
        document.getElementById('modal-info').classList.remove('active');
    });
    document.getElementById('btn-close-quiz').addEventListener('click', () => {
        document.getElementById('modal-quiz').classList.remove('active');
    });
    document.getElementById('btn-restart').addEventListener('click', () => {
        resetGame();
        document.getElementById('modal-complete').classList.remove('active');
        
        // Reset visual
        islands.forEach(island => {
            island.userData.marker.material.color.setHex(0xffd700);
            island.userData.marker.material.emissive.setHex(0xffd700);
        });
        
        player.position.set(0, 0, 0);
        showToast("🔄 Permainan direset!");
    });
    
    // Update UI
    updateUI();
    
    // Hide loading
    setTimeout(() => {
        document.getElementById('loading').style.opacity = '0';
        setTimeout(() => {
            document.getElementById('loading').style.display = 'none';
        }, 800);
    }, 1000);
    
    // Start animation
    animate();
    
    if (loaded) {
        showToast("💾 Permainan dimuat!");
        // Restore visual state
        islands.forEach(island => {
            const key = island.userData.key;
            if (gameState.completedQuizzes.includes(key)) {
                island.userData.marker.material.color.setHex(0x00ff88);
                island.userData.marker.material.emissive.setHex(0x00ff88);
            }
        });
    } else {
        showToast("🌏 Selamat datang di Wawasan Nusantara!");
    }
}

// Start the game
window.addEventListener('load', init);
