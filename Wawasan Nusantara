// ==================== GAME STATE ====================
const gameState = {
    score: 0,
    missionsCompleted: 0,
    visitedIslands: [],
    currentIsland: null,
    playerPos: new THREE.Vector3(0, 0, 0),
    playerRotation: 0,
    isMoving: false,
    completedQuizzes: [],
    savedData: null
};

// ==================== LOCAL STORAGE ====================
function saveGame() {
    const data = {
        score: gameState.score,
        missionsCompleted: gameState.missionsCompleted,
        visitedIslands: [...gameState.visitedIslands],
        completedQuizzes: [...gameState.completedQuizzes],
        timestamp: Date.now()
    };
    try {
        localStorage.setItem('wawasanNusantaraSave', JSON.stringify(data));
    } catch(e) {
        console.log('Save failed:', e);
    }
}

function loadGame() {
    try {
        const saved = localStorage.getItem('wawasanNusantaraSave');
        if (saved) {
            const data = JSON.parse(saved);
            gameState.score = data.score || 0;
            gameState.missionsCompleted = data.missionsCompleted || 0;
            gameState.visitedIslands = data.visitedIslands || [];
            gameState.completedQuizzes = data.completedQuizzes || [];
            gameState.savedData = data;
            return true;
        }
    } catch(e) {
        console.log('Load failed:', e);
    }
    return false;
}

function resetGame() {
    localStorage.removeItem('wawasanNusantaraSave');
    gameState.score = 0;
    gameState.missionsCompleted = 0;
    gameState.visitedIslands = [];
    gameState.completedQuizzes = [];
    updateUI();
}

// ==================== THREE.JS SETUP ====================
let scene, camera, renderer, clock;
let islands = [];
let player, playerGroup;
let sunLight, ambientLight;
let waterMesh;
let clouds = [];
let stars;

const worldSize = 400;

function initThreeJS() {
    scene = new THREE.Scene();
    scene.background = new THREE.Color(0x0a1628);
    scene.fog = new THREE.Fog(0x0a1628, 150, 350);

    camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
    camera.position.set(0, 25, 30);
    camera.lookAt(0, 0, 0);

    renderer = new THREE.WebGLRenderer({ antialias: true, alpha: false });
    renderer.setSize(window.innerWidth, window.innerHeight);
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.2;
    document.getElementById('game-container').appendChild(renderer.domElement);

    clock = new THREE.Clock();

    // Lights
    ambientLight = new THREE.AmbientLight(0x404060, 0.8);
    scene.add(ambientLight);

    sunLight = new THREE.DirectionalLight(0xffeedd, 1.5);
    sunLight.position.set(50, 80, 30);
    sunLight.castShadow = true;
    sunLight.shadow.mapSize.width = 1024;
    sunLight.shadow.mapSize.height = 1024;
    sunLight.shadow.camera.near = 10;
    sunLight.shadow.camera.far = 200;
    sunLight.shadow.camera.left = -80;
    sunLight.shadow.camera.right = 80;
    sunLight.shadow.camera.top = 80;
    sunLight.shadow.camera.bottom = -80;
    scene.add(sunLight);

    const hemiLight = new THREE.HemisphereLight(0x88aaff, 0x223344, 0.6);
    scene.add(hemiLight);

    // Stars
    createStars();

    // Ocean
    createOcean();

    // Islands
    createAllIslands();

    // Player
    createPlayer();

    // Clouds
    createClouds();

    // Resize handler
    window.addEventListener('resize', onResize);
}

function createStars() {
    const starsGeometry = new THREE.BufferGeometry();
    const starsCount = 1500;
    const positions = new Float32Array(starsCount * 3);
    for (let i = 0; i < starsCount * 3; i += 3) {
        positions[i] = (Math.random() - 0.5) * 800;
        positions[i+1] = Math.random() * 200 + 50;
        positions[i+2] = (Math.random() - 0.5) * 800;
    }
    starsGeometry.setAttribute('position', new THREE.BufferAttribute(positions, 3));
    const starsMaterial = new THREE.PointsMaterial({ color: 0xffffff, size: 0.8, transparent: true, opacity: 0.8 });
    stars = new THREE.Points(starsGeometry, starsMaterial);
    scene.add(stars);
}

function createOcean() {
    const oceanGeometry = new THREE.PlaneGeometry(worldSize * 3, worldSize * 3, 64, 64);
    const oceanMaterial = new THREE.MeshStandardMaterial({
        color: 0x1a4a7a,
        transparent: true,
        opacity: 0.85,
        roughness: 0.3,
        metalness: 0.1,
        side: THREE.DoubleSide
    });
    waterMesh = new THREE.Mesh(oceanGeometry, oceanMaterial);
    waterMesh.rotation.x = -Math.PI / 2;
    waterMesh.position.y = -2;
    waterMesh.receiveShadow = true;
    scene.add(waterMesh);
}

function createAllIslands() {
    const positions = [
        { key: 'sumatra', x: -60, z: -40 },
        { key: 'jawa', x: -20, z: 30 },
        { key: 'kalimantan', x: 20, z: -30 },
        { key: 'sulawesi', x: 60, z: 10 },
        { key: 'papua', x: 100, z: -50 },
        { key: 'bali', x: 15, z: 65 },
        { key: 'maluku', x: 80, z: 60 }
    ];

    positions.forEach(pos => {
        const data = ISLAND_DATA[pos.key];
        const island = createIsland(pos.x, pos.z, data, pos.key);
        islands.push(island);
    });
}

function createIsland(x, z, data, key) {
    const group = new THREE.Group();
    group.position.set(x, 0, z);

    // Base island
    const baseGeo = new THREE.CylinderGeometry(8, 10, 3, 8);
    const baseMat = new THREE.MeshStandardMaterial({ color: 0x3a6b3a, roughness: 0.9 });
    const base = new THREE.Mesh(baseGeo, baseMat);
    base.position.y = -1;
    base.castShadow = true;
    base.receiveShadow = true;
    group.add(base);

    // Beach ring
    const beachGeo = new THREE.CylinderGeometry(10.5, 10.5, 0.8, 12);
    const beachMat = new THREE.MeshStandardMaterial({ color: 0xeedd99, roughness: 0.8 });
    const beach = new THREE.Mesh(beachGeo, beachMat);
    beach.position.y = -1.8;
    beach.receiveShadow = true;
    group.add(beach);

    // Mountain/peak
    const peakGeo = new THREE.ConeGeometry(5, 8, 8);
    const peakMat = new THREE.MeshStandardMaterial({ color: 0x4a7a4a, roughness: 0.7 });
    const peak = new THREE.Mesh(peakGeo, peakMat);
    peak.position.y = 3.5;
    peak.castShadow = true;
    peak.receiveShadow = true;
    group.add(peak);

    // Snow cap
    const snowGeo = new THREE.ConeGeometry(2, 3, 8);
    const snowMat = new THREE.MeshStandardMaterial({ color: 0xffffff, roughness: 0.5 });
    const snow = new THREE.Mesh(snowGeo, snowMat);
    snow.position.y = 6.5;
    snow.castShadow = true;
    group.add(snow);

    // Trees
    for (let i = 0; i < 6; i++) {
        const angle = (i / 6) * Math.PI * 2;
        const radius = 6 + Math.random() * 2;
        const treeX = Math.cos(angle) * radius;
        const treeZ = Math.sin(angle) * radius;
        
        const trunkGeo = new THREE.CylinderGeometry(0.3, 0.4, 2, 6);
        const trunkMat = new THREE.MeshStandardMaterial({ color: 0x8B4513 });
        const trunk = new THREE.Mesh(trunkGeo, trunkMat);
        trunk.position.set(treeX, 1, treeZ);
        trunk.castShadow = true;
        group.add(trunk);

        const leavesGeo = new THREE.ConeGeometry(1.5, 3, 6);
        const leavesMat = new THREE.MeshStandardMaterial({ color: 0x2d5a2d });
        const leaves = new THREE.Mesh(leavesGeo, leavesMat);
        leaves.position.set(treeX, 3, treeZ);
        leaves.castShadow = true;
        group.add(leaves);
    }

    // Floating label marker
    const markerGeo = new THREE.SphereGeometry(0.5, 8, 8);
    const markerMat = new THREE.MeshStandardMaterial({ 
        color: 0xffd700, 
        emissive: 0xffd700, 
        emissiveIntensity: 0.8 
    });
    const marker = new THREE.Mesh(markerGeo, markerMat);
    marker.position.y = 12;
    marker.name = 'marker';
    group.add(marker);

    // Glow ring around island
    const ringGeo = new THREE.RingGeometry(11, 12, 32);
    const ringMat = new THREE.MeshBasicMaterial({ 
        color: 0x00e5ff, 
        transparent: true, 
        opacity: 0.3, 
        side: THREE.DoubleSide 
    });
    const ring = new THREE.Mesh(ringGeo, ringMat);
    ring.rotation.x = -Math.PI / 2;
    ring.position.y = -1.9;
    group.add(ring);

    group.userData = { key, data, ring, marker };
    scene.add(group);
    return group;
}

function createPlayer() {
