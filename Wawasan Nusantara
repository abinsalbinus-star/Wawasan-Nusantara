<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Wawasan Nusantara - Open World PPKn</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
        }
        body {
            overflow: hidden;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: #000;
        }
        #game-container {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
        }
        /* UI Overlay */
        #ui-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: 10;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 15px;
        }
        .top-bar {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            width: 100%;
            pointer-events: none;
        }
        .stats {
            background: rgba(0, 20, 40, 0.8);
            backdrop-filter: blur(8px);
            border: 2px solid #ffd700;
            border-radius: 12px;
            padding: 8px 14px;
            color: #fff;
            font-size: 14px;
            font-weight: bold;
            display: flex;
            gap: 15px;
            pointer-events: auto;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
        }
        .stats span {
            color: #ffd700;
        }
        .island-info {
            background: rgba(0, 20, 40, 0.85);
            backdrop-filter: blur(8px);
            border: 2px solid #00e5ff;
            border-radius: 12px;
            padding: 6px 12px;
            color: #fff;
            font-size: 12px;
            text-align: right;
            pointer-events: auto;
            max-width: 45%;
        }
        .island-info .name {
            color: #00e5ff;
            font-weight: bold;
            font-size: 14px;
        }
        .bottom-controls {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            width: 100%;
            pointer-events: none;
        }
        .joystick-area {
            width: 130px;
            height: 130px;
            pointer-events: auto;
            position: relative;
            touch-action: none;
        }
        .joystick-base {
            width: 100%;
            height: 100%;
            background: rgba(255, 215, 0, 0.15);
            border: 2px solid rgba(255, 215, 0, 0.5);
            border-radius: 50%;
            position: relative;
            box-shadow: 0 0 20px rgba(255, 215, 0, 0.2);
        }
        .joystick-knob {
            width: 55px;
            height: 55px;
            background: radial-gradient(circle, #ffd700, #ff8c00);
            border-radius: 50%;
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            box-shadow: 0 0 15px rgba(255, 215, 0, 0.6);
            border: 2px solid #fff;
        }
        .action-buttons {
            display: flex;
            flex-direction: column;
            gap: 10px;
            pointer-events: auto;
            align-items: flex-end;
        }
        .btn {
            background: rgba(0, 20, 40, 0.85);
            backdrop-filter: blur(8px);
            border: 2px solid #ffd700;
            border-radius: 50px;
            padding: 12px 24px;
            color: #ffd700;
            font-weight: bold;
            font-size: 14px;
            cursor: pointer;
            pointer-events: auto;
            transition: all 0.2s;
            text-transform: uppercase;
            letter-spacing: 1px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.5);
            min-width: 110px;
            text-align: center;
        }
        .btn:active {
            transform: scale(0.95);
            background: rgba(255, 215, 0, 0.3);
        }
        .btn.interact {
            border-color: #00e5ff;
            color: #00e5ff;
        }
        .btn.quiz {
            border-color: #ff6b6b;
            color: #ff6b6b;
        }
        /* Modal */
        .modal {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            backdrop-filter: blur(6px);
            display: none;
            justify-content: center;
            align-items: center;
            z-index: 100;
            pointer-events: auto;
            padding: 20px;
        }
        .modal.active {
            display: flex;
        }
        .modal-content {
            background: linear-gradient(145deg, #0a1628, #1a2a4a);
            border: 2px solid #ffd700;
            border-radius: 20px;
            padding: 25px;
            max-width: 400px;
            width: 100%;
            color: #fff;
            box-shadow: 0 0 40px rgba(255, 215, 0, 0.3);
            max-height: 80vh;
            overflow-y: auto;
        }
        .modal-content h2 {
            color: #ffd700;
            margin-bottom: 15px;
            font-size: 20px;
            text-align: center;
            border-bottom: 1px solid rgba(255, 215, 0, 0.3);
            padding-bottom: 10px;
        }
        .modal-content p {
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 15px;
            color: #c0c8d8;
        }
        .modal-content .question {
            font-size: 16px;
            font-weight: bold;
            color: #00e5ff;
            margin-bottom: 15px;
            line-height: 1.5;
        }
        .option-btn {
            display: block;
            width: 100%;
            padding: 12px 15px;
            margin-bottom: 10px;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 215, 0, 0.4);
            border-radius: 10px;
            color: #fff;
            font-size: 14px;
            cursor: pointer;
            transition: all 0.2s;
            text-align: left;
        }
        .option-btn:active {
            background: rgba(255, 215, 0, 0.2);
            transform: scale(0.98);
        }
        .option-btn.correct {
            background: rgba(0, 200, 100, 0.3);
            border-color: #00c864;
        }
        .option-btn.wrong {
            background: rgba(255, 50, 50, 0.3);
            border-color: #ff3232;
        }
        .feedback {
            margin-top: 15px;
            padding: 12px;
            border-radius: 10px;
            font-size: 14px;
            text-align: center;
            font-weight: bold;
        }
        .feedback.correct {
            background: rgba(0, 200, 100, 0.2);
            color: #00c864;
            border: 1px solid #00c864;
        }
        .feedback.wrong {
            background: rgba(255, 50, 50, 0.2);
            color: #ff6b6b;
            border: 1px solid #ff6b6b;
        }
        .modal-actions {
            display: flex;
            gap: 10px;
            margin-top: 20px;
        }
        .modal-actions .btn {
            flex: 1;
            min-width: auto;
            padding: 12px;
            font-size: 13px;
        }
        /* Mini Map */
        .minimap {
            position: fixed;
            top: 80px;
            right: 15px;
            width: 90px;
            height: 90px;
            background: rgba(0, 20, 40, 0.8);
            border: 2px solid #00e5ff;
            border-radius: 10px;
            z-index: 10;
            overflow: hidden;
            pointer-events: none;
        }
        .minimap canvas {
            width: 100%;
            height: 100%;
        }
        /* Toast Notification */
        .toast {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%) scale(0);
            background: rgba(0, 20, 40, 0.95);
            border: 2px solid #ffd700;
            border-radius: 15px;
            padding: 20px 30px;
            color: #ffd700;
            font-weight: bold;
            font-size: 18px;
            text-align: center;
            z-index: 200;
            transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            pointer-events: none;
            box-shadow: 0 0 30px rgba(255, 215, 0, 0.4);
        }
        .toast.show {
            transform: translate(-50%, -50%) scale(1);
        }
        /* Loading Screen */
        #loading {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: #0a1628;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            z-index: 1000;
            color: #ffd700;
            transition: opacity 0.8s;
        }
        #loading h1 {
            font-size: 24px;
            margin-bottom: 20px;
            text-shadow: 0 0 20px rgba(255, 215, 0, 0.5);
        }
        .loader {
            width: 60px;
            height: 60px;
            border: 4px solid rgba(255, 215, 0, 0.2);
            border-top-color: #ffd700;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            to { transform: rotate(360deg); }
        }
        .progress-text {
            margin-top: 15px;
            font-size: 14px;
            color: #8899aa;
        }
        /* Scrollbar */
        .modal-content::-webkit-scrollbar {
            width: 6px;
        }
        .modal-content::-webkit-scrollbar-track {
            background: rgba(255,255,255,0.05);
            border-radius: 3px;
        }
        .modal-content::-webkit-scrollbar-thumb {
            background: #ffd700;
            border-radius: 3px;
        }
    </style>
</head>
<body>

<div id="loading">
    <h1>🌏 Wawasan Nusantara</h1>
    <div class="loader"></div>
    <div class="progress-text">Memuat dunia...</div>
</div>

<div id="game-container"></div>

<div id="ui-overlay">
    <div class="top-bar">
        <div class="stats">
            <div>⭐ Skor: <span id="score">0</span></div>
            <div>📜 Misi: <span id="missions">0</span>/7</div>
        </div>
        <div class="island-info">
            <div class="name" id="island-name">Laut Lepas</div>
            <div id="island-desc">Jelajahi nusantara</div>
        </div>
    </div>
    
    <div class="minimap" id="minimap">
        <canvas id="minimap-canvas" width="180" height="180"></canvas>
    </div>
    
    <div class="bottom-controls">
        <div class="joystick-area" id="joystick-area">
            <div class="joystick-base">
                <div class="joystick-knob" id="joystick-knob"></div>
            </div>
        </div>
        <div class="action-buttons">
            <button class="btn interact" id="btn-interact">🔍 Jelajahi</button>
            <button class="btn quiz" id="btn-quiz">📝 Kuis</button>
        </div>
    </div>
</div>

<!-- Modal Info -->
<div class="modal" id="modal-info">
    <div class="modal-content">
        <h2 id="info-title">📖 Informasi</h2>
        <p id="info-text"></p>
        <div class="modal-actions">
            <button class="btn" id="btn-close-info">Tutup</button>
        </div>
    </div>
</div>

<!-- Modal Quiz -->
<div class="modal" id="modal-quiz">
    <div class="modal-content">
        <h2 id="quiz-title">📝 Kuis Wawasan Nusantara</h2>
        <div class="question" id="quiz-question"></div>
        <div id="quiz-options"></div>
        <div class="feedback" id="quiz-feedback" style="display:none;"></div>
        <div class="modal-actions">
            <button class="btn" id="btn-close-quiz">Tutup</button>
        </div>
    </div>
</div>

<!-- Modal Complete -->
<div class="modal" id="modal-complete">
    <div class="modal-content" style="text-align:center;">
        <h2>🎉 Selamat!</h2>
        <p>Kamu telah menyelesaikan semua misi Wawasan Nusantara!</p>
        <p style="color:#ffd700; font-size:24px; font-weight:bold;" id="final-score">Skor: 0</p>
        <p style="font-size:12px; color:#8899aa;">Kamu adalah generasi penerus yang memahami Wawasan Nusantara! 🇮🇩</p>
        <div class="modal-actions">
            <button class="btn" id="btn-restart">Main Lagi</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div class="toast" id="toast"></div>

<script type="importmap">
{
    "imports": {
        "three": "https://unpkg.com/three@0.160.0/build/three.module.js",
        "three/addons/": "https://unpkg.com/three@0.160.0/examples/jsm/"
    }
}
</script>

<script type="module">
import * as THREE from 'three';
import { OrbitControls } from 'three/addons/controls/OrbitControls.js';

// ==================== DATA WAWASAN NUSANTARA ====================
const ISLAND_DATA = {
    sumatra: {
